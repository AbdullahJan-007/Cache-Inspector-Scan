  "author": "Abdullah Jan",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.mjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./lib/index.mjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AbdullahJan-007/Cache-Inspector-Scan.git"
  },
  "bugs": {
    "url": "https://github.com/AbdullahJan-007/Cache-Inspector-Scan/issues"
  },
  "homepage": "https://github.com/AbdullahJan-007/Cache-Inspector-Scan#readme",
  "keywords": [
    "nextjs",
    "next",
    "caching",
    "cli",
    "static-analysis",
    "app-router",
    "server-actions",
    "sarif",
    "lsp",
    "linter"
  ],
  "files": [
    "bin",
    "lib",
    "types",
    "README.md",
    "LICENSE"
  ],
  "bin": {
